# Server
SERVER_PORT=8080
SERVER_ENV=development
PUBLIC_URL=http://localhost

# Database
DATABASE_URL=postgresql+asyncpg://paca:paca@localhost:5432/paca

# Redis / Valkey
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_SESSION_TTL_HOURS=24

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Storage (minio | s3)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_PUBLIC_URL=http://localhost/storage
STORAGE_REGION=us-east-1
STORAGE_BUCKET=paca
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_USE_SSL=false

# Security
ENCRYPTION_KEY=
AGENT_API_KEY=

# Cache TTLs (seconds)
CACHE_PROJECT_TTL=300
CACHE_CONFIG_TTL=600
CACHE_SPRINT_TTL=120

# AI Agent
AI_AGENT_URL=http://ai-agent:8080

# Cookie
COOKIE_SECURE=false
